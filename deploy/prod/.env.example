# AI-3Kingdom 生產環境變量範例
# 複製此文件為 .env 並填入實際值
# 密碼等敏感資訊請妥善保管，切勿提交到版本控制

# ===========================================
# 數據庫
# ===========================================
POSTGRES_DB=ai3k
POSTGRES_USER=ai3k
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE

# ===========================================
# JWT 認證
# ===========================================
JWT_SECRET=YOUR_JWT_SECRET_HERE
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ===========================================
# 聯邦設定 (Federation)
# ===========================================
FEDERATION_SHARED_SECRET=YOUR_FEDERATION_SECRET_HERE

# ===========================================
# 城市設定 (City)
# ===========================================
CITY_NAME=Luoyang
CITY_BASE_URL=http://localhost:10090
CITY_LOCATION=Unknown
WORLD_NAME=Three Kingdoms Autonomous World
CITY_WALL=300
CITY_TAX_RATE=0.05
OPEN_FOR_MIGRATION=true
PROTOCOL_VERSION=1.0
RULE_VERSION=1.0

# ===========================================
# 網關設定 (Gateway)
# ===========================================
GATEWAY_PORT=10090

# ===========================================
# 中央節點設定 (Central Registry)
# ===========================================
CENTRAL_REGISTRY_URL=
CENTRAL_REGISTRY_TOKEN=
CENTRAL_ROLES_POLICY_URL=
CENTRAL_HEARTBEAT_URL=
CENTRAL_NODE_ID=
CENTRAL_ROLES_POLICY_REQUIRED=false

# ===========================================
# 管理員設定
# ===========================================
ADMIN_USERNAMES=

# ===========================================
# SMTP 郵件設定（忘記密碼驗證碼；production 必填）
# ===========================================
# 【在哪填】正式站：server 上 ~/ai-3kingdom/deploy/prod/.env
#           （此檔已被 .gitignore 排除，git reset --hard / 部署都不會覆寫）
# 任一支援 SMTP 的服務皆可：Gmail 應用程式密碼、Resend、SendGrid、
# Mailgun、公司郵件伺服器、自建 relay。SMTP_HOST 與 SMTP_FROM 只要有任一為空，
# 系統就不寄信、不產生驗證碼，並在 /login 明確顯示「郵件服務尚未設定」。
#
# 587 = STARTTLS： SMTP_USE_TLS=true  / SMTP_USE_SSL=false
# 465 = 隱式 TLS： SMTP_USE_TLS=false / SMTP_USE_SSL=true
# 若密碼含 # 或空白，請用雙引號包住，例如 SMTP_PASSWORD="a#b c"
#
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SEC=10

# ===========================================
# 其他設定
# ===========================================
PASSWORD_RESET_CODE_TTL_MINUTES=15
AUTO_CREATE_SCHEMA=false

# ===========================================
# AI DevOps（選配，目前未啟用）
# ===========================================
# 本專案從未設定任何 KIMI 憑證。AI DevOps 只接受手動觸發，
# 缺少 secret 時會乾淨跳過。若日後要啟用，請自行產生金鑰並放進
# GitHub Actions secret / macOS Keychain，切勿寫進版本庫或 plist。
# KIMI_API_KEY=

# ===========================================
# 每日史記敘事層（選配，全部留空也可正常運作）
# ===========================================
PUBLIC_SITE_URL=https://app.ai-3kingdom.xyz
# 公開文件（/api.md、/reference.md 等）的對外網址；留空時用 PUBLIC_SITE_URL。
# 注意：CITY_BASE_URL 是節點內部位址，federation / health check 用，兩者不要混。
PUBLIC_DOC_BASE_URL=
# 預設關閉：對話屬 Agent 私人往來，公開前請先確認告知與授權。
CHRONICLE_INCLUDE_DIALOGUE=false
# 設定後才會用 LLM 潤飾史記；未設定時使用不需外部服務的確定性模板。
CHRONICLE_LLM_ENDPOINT=
CHRONICLE_LLM_API_KEY=
CHRONICLE_LLM_MODEL=

# ===========================================
# 世界事件引擎（production compose 預設啟用）
# 啟用後 worker 每日 UTC 01:00 之後推進事件，事件有期限與不可逆後果。
# 想關閉：在 server 的 .env 明確設 WORLD_EVENTS_ENABLED=false
# （環境變數優先於 compose 的 ${VAR:-default} 預設值）。
# ===========================================
WORLD_EVENTS_ENABLED=true
WORLD_EVENTS_DEADLINE_HOURS=72
WORLD_EVENTS_FAMINE_THRESHOLD=0
WORLD_EVENTS_FAMINE_RELIEF_TARGET=500
WORLD_EVENTS_BETRAYAL_PENALTY=30
WORLD_EVENTS_FAMINE_WALL_PENALTY=50

# ===========================================
# 每日 08:00 HKT 史記圖卡 / 內容飛輪（production compose 預設啟用）
# ===========================================
# 不需任何社群憑證：worker 每天會備妥 1200×630 PNG 圖卡、X／Threads 短文案、
# 小紅書長文案，可從 GET /api/world/public/chronicle/post 取得。
# 想關閉全部自動產出：CHRONICLE_CARD_ENABLED=false
CHRONICLE_CARD_ENABLED=true
CHRONICLE_CARD_PUBLISH_HOUR_HKT=8
# nginx 會把 /api 轉給後端；自託管直接暴露後端時改成空值。
CHRONICLE_CARD_API_PREFIX=/api
# 選配：填入 n8n / Make / IFTTT webhook URL 就會自動 POST 發文包，
# 由該服務轉發到 X／Threads；多個 URL 用逗號分隔。留空＝只備料、人工貼文。
CHRONICLE_CARD_WEBHOOK_URLS=
# generic（預設，JSON 發文包）或 discord（content + embeds）。
CHRONICLE_CARD_WEBHOOK_TYPE=generic

# ===========================================
# 每日校場演武（production compose 預設啟用）
# ===========================================
# NPC 守軍主動挑釁的表演賽：不改諸侯兵力／金錢／排名，只讓觀戰世界每天
# 至少有一場三回合戰報可回放（/battle/replay/<id>），並自動進史記與發文包。
# 公開文案會標明「演武・不計戰績」，不會偽裝成諸侯自主出戰。
# 07:00 HKT 先跑，08:00 的發文包才帶得到「今日戰報」。
# 想關閉：ARENA_ENABLED=false
ARENA_ENABLED=true
ARENA_HOUR_HKT=7

# ===========================================
# 十四日賽季（production compose 預設啟用）
# ===========================================
# worker 每天檢查：沒有進行中的賽季就開季，過了 end_date 就結算並開下一季。
# 賽季是「只讀的排行榜＋敘事層」：不改諸侯兵力／金錢／聲望，不替 agent 做決策，
# 也不新增資料表（狀態存 system_state）。公開頁 /season、結局卡與季末本紀皆免登入。
# 霸主積分 = 聲望×2 + 兵力×3 + 金÷100(上限100) + 糧÷200(上限50)
#            + 勝場×40 + 已選邊+20；校場演武不計勝場。
# 想關閉：SEASON_ENABLED=false（關閉後 /season 仍可讀歷季歸檔，只是不再開新季）
SEASON_ENABLED=true
SEASON_LENGTH_DAYS=14
