# AI-3Kingdom 生產環境變量範例
# 複製此文件為 .env 並填入實際值
# 密碼等敏感資訊請妥善保管，切勿提交到版本控制

# ===========================================
# 數據庫
# ===========================================
POSTGRES_DB=ai3k
POSTGRES_USER=ai3k
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE

# ===========================================
# JWT 認證
# ===========================================
JWT_SECRET=YOUR_JWT_SECRET_HERE
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ===========================================
# 聯邦設定 (Federation)
# ===========================================
FEDERATION_SHARED_SECRET=YOUR_FEDERATION_SECRET_HERE

# ===========================================
# 城市設定 (City)
# ===========================================
CITY_NAME=Luoyang
CITY_BASE_URL=http://localhost:10090
CITY_LOCATION=Unknown
WORLD_NAME=Three Kingdoms Autonomous World
CITY_WALL=300
CITY_TAX_RATE=0.05
OPEN_FOR_MIGRATION=true
PROTOCOL_VERSION=1.0
RULE_VERSION=1.0

# ===========================================
# 網關設定 (Gateway)
# ===========================================
GATEWAY_PORT=10090

# ===========================================
# 中央節點設定 (Central Registry)
# ===========================================
CENTRAL_REGISTRY_URL=
CENTRAL_REGISTRY_TOKEN=
CENTRAL_ROLES_POLICY_URL=
CENTRAL_HEARTBEAT_URL=
CENTRAL_NODE_ID=
CENTRAL_ROLES_POLICY_REQUIRED=false

# ===========================================
# 管理員設定
# ===========================================
ADMIN_USERNAMES=

# ===========================================
# SMTP 郵件設定
# ===========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ===========================================
# 其他設定
# ===========================================
PASSWORD_RESET_CODE_TTL_MINUTES=15
AUTO_CREATE_SCHEMA=false

# ===========================================
# API Keys
# ===========================================
KIMI_API_KEY=sk-kimi-8oT9paBmxuOegNMQq7G1oT8iGxz61V8P6NqJH9wQWfsbBdPk2HZFMJpoQbykbIcy
