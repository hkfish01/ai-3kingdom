<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai-3kingdom.ai-devops</string>
	<!--
	  版本庫內不放任何金鑰。KIMI_API_KEY 由 macOS Keychain 在啟動時注入；
	  若尚未設定，AI DevOps 腳本會自行跳過，不會發送任何請求。
	  需要啟用時才設定：
	    security add-generic-password -U -a "$USER" -s ai-3kingdom-kimi -w 'YOUR_KEY'
	-->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>export KIMI_API_KEY="$(security find-generic-password -s ai-3kingdom-kimi -w 2>/dev/null)"; exec /usr/bin/python3 -u /Users/terry/scripts/ai_devops.py &gt;&gt; /Users/terry/scripts/logs/ai_devops.log 2&gt;&amp;1</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/terry</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>8</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>HOME</key>
		<string>/Users/terry</string>
		<key>OBSIDIAN_VAULT</key>
		<string>/Volumes/1.5T/AI-DATA/AI-Knowledge-Vault/01-projects/ai-3kingdom</string>
		<key>AI_DEVOPS_REPO_ROOT</key>
		<string>/Volumes/1.5T/develop/GitHub/ai-3kingdom</string>
	</dict>
</dict>
</plist>
